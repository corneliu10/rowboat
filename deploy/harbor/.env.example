# Harbor deployment-mode env (see apps/harbor/packages/server/src/main.ts).
# Copy to `.env` next to this file to override locally — never commit real
# secrets. No telemetry keys are set here on purpose (POSTHOG_KEY /
# VITE_PUBLIC_POSTHOG_KEY must stay absent; the server logs
# "[Analytics] POSTHOG_KEY not set; analytics disabled").

# Multi-org mode: the org is resolved from the request host
# (main.ts:96-104). Required.
HARBOR_MODE=deployment

# Postgres. Matches the `postgres` service in docker-compose.yml, which runs
# with POSTGRES_HOST_AUTH_METHOD=trust — local spike only, so there is no
# password to put here. Required (main.ts:98).
DATABASE_URL=postgres://harbor@postgres:5432/harbor

# Orgs live at <slug>.<APEX_DOMAIN>; the apex itself serves org creation and
# "my orgs" (main.ts:117-118, apex.ts:49-69). Required (main.ts:98).
APEX_DOMAIN=harbor.localtest.me

# Container port (Render sets this; main.ts:52 defaults to 4272).
PORT=4272

# Disk blob driver, single-node (main.ts:82-84). The compose file mounts a
# named volume here. Unset = uploads refused loudly at the route.
BLOBS_DIR=/blobs

# --- OIDC (main.ts:97-111,139-143). Empty = not configured. ---
# The pinned authorization-server issuer every org trusts, e.g.
# https://<project>.supabase.co/auth/v1. Required in deployment mode:
# without it the process exits before listening
# ("HARBOR_MODE=deployment requires AUTH_ISSUER").
AUTH_ISSUER=
# Optional `aud` check. Off by default on purpose: shared AS realms mint
# realm-generic audiences (Supabase: "authenticated"), so membership — not
# the audience — is the authorization boundary (auth-oidc.ts:18-25).
AUTH_AUDIENCE=
# The AS's publishable/anon key (public by design). Mounts /oauth/consent,
# the login/consent page whose sign-in buttons are derived from the AS's
# /settings (consent.ts:13-18,113-133). Implies a Supabase Auth (GoTrue) AS:
# an org whose AS hosts its own login+consent never mounts this route
# (consent.ts:9-11).
AUTH_PUBLISHABLE_KEY=

# --- S3-compatible blob driver (main.ts:63-81). Empty = disk driver above. ---
# Credentials ride the AWS provider chain or the two *_ACCESS_KEY_* vars;
# endpoint/forcePathStyle reach MinIO/R2/B2 (blobs-s3.ts).
BLOBS_S3_BUCKET=
BLOBS_S3_REGION=
BLOBS_S3_ENDPOINT=
BLOBS_S3_FORCE_PATH_STYLE=
BLOBS_S3_ACCESS_KEY_ID=
BLOBS_S3_SECRET_ACCESS_KEY=

# --- Optional knobs (main.ts:87-90,157-159). ---
# Postgres pool ceiling shared by every org on the deployment (default 10).
# DATABASE_POOL_MAX=
# Upload cap bytes for the raw-bytes blob route (default 100MB).
# HARBOR_MAX_BLOB_BYTES=
# Single-org dev path only (startDevHarbor, main.ts:129-171) — unused with
# HARBOR_MODE=deployment.
# HARBOR_ORG=
# HARBOR_ALLOWED_DOMAINS=
